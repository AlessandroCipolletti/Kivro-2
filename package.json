{
  "name": "kivro",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node --test tests/architecture.test.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:postgres:m01": "sh tools/test-m01-postgres.sh",
    "test:postgres:m02": "sh tools/test-m02-postgres.sh",
    "test:postgres:m03": "sh tools/test-m03-postgres.sh",
    "test:postgres:m05": "sh tools/test-m05-postgres.sh",
    "test:postgres:m06": "pnpm build && sh tools/test-m06-postgres.sh",
    "test:postgres:m07": "pnpm build && sh tools/test-m07-postgres.sh",
    "test:postgres:m08": "pnpm build && sh tools/test-m08-postgres.sh",
    "test:postgres:m09": "pnpm build && sh tools/test-m09-postgres.sh",
    "test:research:live": "pnpm build && node tools/test-m06-public-fetch.mjs",
    "test:storage:minio": "pnpm build && node --test tests/s3-storage-local-integration.mjs",
    "test:storage:seaweedfs": "pnpm build && node --test tests/s3-storage-seaweedfs-local-integration.mjs",
    "test:auth:local": "pnpm build && node --env-file=.env.local --test tests/auth-local-integration.mjs",
    "test:seller:local": "pnpm build && node --env-file=.env.local --test tests/seller-profile-local-integration.mjs",
    "test:auth:browser": "pnpm build && playwright test -c playwright.config.mts",
    "test:sandbox:docker": "pnpm build && node --test tests/docker-sandbox-local-integration.mjs",
    "test:sandbox:output": "pnpm build && node --test tests/docker-sandbox-output-local-integration.mjs",
    "test:sandbox:job-control": "pnpm build && node --test tests/docker-job-control-local-integration.mjs tests/docker-controlled-execution-local-integration.mjs",
    "test:output:storage": "pnpm build && node --test tests/docker-output-storage-local-integration.mjs",
    "test:openclaw:isolation": "pnpm build && node tools/test-openclaw-isolated.mjs",
    "test:openclaw:image": "pnpm build && docker build -f runtime/openclaw/Dockerfile -t kivro-openclaw-runtime:m07 runtime/openclaw && node --test tests/docker-openclaw-image-local-integration.mjs",
    "test:openclaw:broker": "pnpm build && docker build -f runtime/openclaw/Dockerfile -t kivro-openclaw-runtime:m07 runtime/openclaw && node --test tests/docker-broker-sidecar-local-integration.mjs",
    "test:openclaw:execution": "pnpm build && docker build -f runtime/openclaw/Dockerfile -t kivro-openclaw-runtime:m07 runtime/openclaw && node --test tests/docker-openclaw-image-local-integration.mjs tests/docker-broker-sidecar-local-integration.mjs tests/docker-openclaw-exec-local-integration.mjs tests/docker-openclaw-file-tools-local-integration.mjs tests/docker-worker-supervisor-local-integration.mjs",
    "openclaw:approve-local-image": "pnpm build && node tools/approve-m07-openclaw-image.mjs",
    "test:openclaw:readonly-live": "pnpm build && node tools/test-openclaw-readonly-live.mjs",
    "build": "tsc -p tsconfig.build.json",
    "openclaw:inspect": "pnpm build && node tools/inspect-openclaw.mjs",
    "worker": "pnpm build && node tools/kivro-worker.mjs",
    "worker:sync-controls": "pnpm build && node tools/kivro-worker-sync.mjs",
    "scheduler": "pnpm build && node tools/kivro-scheduler.mjs",
    "agent:scheduler": "node --env-file=.env.local tools/kivro-agent-scheduler.mjs",
    "local:agent:setup": "node tools/setup-local-agent.mjs",
    "auth:mail": "pnpm build && node tools/auth-mailer.mjs",
    "local:auth:mail": "pnpm build && node --env-file=.env.local tools/auth-mailer.mjs",
    "local:auth:setup": "node tools/setup-local-auth.mjs",
    "local:storage:prepare": "node tools/prepare-local-storage.mjs",
    "local:storage:bucket": "node --env-file=.env.local tools/create-local-storage-bucket.mjs",
    "local:auth:up": "pnpm local:auth:setup && pnpm local:webhooks:setup && pnpm local:storage:prepare && docker compose --env-file .env.local -f compose.local.yaml up -d postgres mail storage && pnpm local:storage:bucket",
    "local:auth:migrate": "node --env-file=.env.local tools/run-local-migrations.mjs",
    "test:postgres:m10": "pnpm build && sh tools/test-m10-postgres.sh",
    "test:browser:m10": "pnpm build && sh tools/test-m10-browser.sh",
    "test:postgres:m11": "pnpm build && sh tools/test-m11-postgres.sh",
    "test:postgres:m12": "pnpm build && sh tools/test-m12-postgres.sh",
    "test:browser:m12": "pnpm build && sh tools/test-m12-browser.sh",
    "test:postgres:m13": "pnpm build && sh tools/test-m13-postgres.sh",
    "test:browser:m13": "pnpm build && sh tools/test-m13-browser.sh",
    "webhook:dispatch": "pnpm build && node tools/kivro-webhook-dispatch.mjs",
    "local:webhooks:setup": "node tools/setup-local-webhooks.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@napi-rs/keyring": "2.1.0",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.7",
    "json5": "2.2.3",
    "nodemailer": "7.0.6",
    "pg": "8.23.1",
    "tar-stream": "3.1.7",
    "yaml": "2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/tar-stream": "3.1.4",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
