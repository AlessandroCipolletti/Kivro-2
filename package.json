{
  "name": "kivro",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node --test tests/architecture.test.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:postgres:m01": "sh tools/test-m01-postgres.sh",
    "test:openclaw:isolation": "pnpm build && node tools/test-openclaw-isolated.mjs",
    "build": "tsc -p tsconfig.build.json",
    "openclaw:inspect": "pnpm build && node tools/inspect-openclaw.mjs",
    "worker": "pnpm build && node tools/kivro-worker.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
