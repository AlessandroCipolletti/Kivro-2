# Esempi illustrativi: non usare i segnaposto come credenziali reali.
# Per lo sviluppo locale esegui `pnpm local:auth:up`: crea .env.local privata
# con password, segreti e storage coerenti con Docker Compose.

# Modalità Node/Next: development in locale; production nel deployment.
NODE_ENV=development

# Password PostgreSQL del Compose locale; generata da pnpm local:auth:setup.
KIVRO_LOCAL_DB_PASSWORD=replace-me-db-password

# Connessione PostgreSQL; in locale usa la password generata sopra, in produzione il provider DB.
DATABASE_URL=postgresql://kivro:replace-me-db-password@127.0.0.1:15432/kivro

# Redis è opzionale/non avviato dal Compose attuale; usa l'URL del provider Redis quando servirà.
REDIS_URL=redis://127.0.0.1:6379

# Endpoint S3 compatibile; in locale è SeaweedFS, in deployment lo fornisce lo storage scelto.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:18333

# Regione S3 richiesta dall'adapter; in locale è us-east-1, in cloud viene dal provider.
OBJECT_STORAGE_REGION=us-east-1

# Bucket privato per gli asset; creato in locale da pnpm local:auth:up.
OBJECT_STORAGE_BUCKET=kivro-local-private

# ID della credenziale S3; in locale è configurato da pnpm local:storage:prepare.
OBJECT_STORAGE_ACCESS_KEY_ID=kivrolocal

# Segreto S3; generato in .env.local da pnpm local:storage:prepare o dal provider storage.
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me-generated-storage-secret

# Chiave API Stripe in modalità test; ottienila dalle chiavi API del tuo account Stripe (M08).
STRIPE_SECRET_KEY=sk_test_replace_me

# Segreto di firma del webhook Stripe; ottienilo dall'endpoint webhook configurato (M08).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ID del client OAuth Web Google; crealo nel progetto Google Cloud con redirect
# http://localhost:3000/api/auth/callback/google per lo sviluppo locale.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Segreto dello stesso client OAuth Web Google; Google Cloud lo mostra con l'ID.
GOOGLE_CLIENT_SECRET=replace-me-google-client-secret

# Segreto di sessione riservato alla configurazione futura; genera un valore casuale privato.
SESSION_SECRET=replace-me-random-session-secret

# Origine pubblica del Web/API; in locale è Next.js, in produzione è il dominio HTTPS.
APP_ORIGIN=http://localhost:3000

# Firma delle sessioni Better Auth; generata da pnpm local:auth:setup
# oppure con `openssl rand -base64 48` per un deployment.
BETTER_AUTH_SECRET=replace-me-generated-auth-secret

# Chiave base64 di 32 byte per cifrare token/link dell'outbox auth;
# generata da pnpm local:auth:setup oppure con `openssl rand -base64 32`.
AUTH_OUTBOX_KEY_BASE64=replace-me-base64-32-byte-key

# Host SMTP: Mailpit in locale; per il deployment usa l'host del provider email.
SMTP_HOST=127.0.0.1

# Porta SMTP: Mailpit espone 11025 in locale; il provider indica la propria porta.
SMTP_PORT=11025

# Mittente delle email di verifica/reset; usa un indirizzo autorizzato dal provider SMTP.
SMTP_FROM="Kivro Dev <no-reply@kivro.local>"

# Protezione SMTP: LOCAL_PLAINTEXT solo su loopback; STARTTLS o TLS per il deployment.
SMTP_SECURITY=LOCAL_PLAINTEXT

# Utente SMTP del provider; Mailpit locale non richiede autenticazione.
SMTP_USERNAME=example-smtp-user

# Password/token SMTP abbinato all'utente; Mailpit locale non lo richiede.
SMTP_PASSWORD=replace-me-smtp-password

# URL stabile di discovery del Worker; lo fornirà il deployment Kivro (non attivo ora).
WORKER_DISCOVERY_URL=https://discovery.example.invalid

# Credenziale del provider Brave Search per il broker cloud; creala nel pannello Brave Search API.
# M06 non la invia mai a Worker, OpenClaw o browser; senza chiave la ricerca live resta disabilitata.
KIVRO_BRAVE_SEARCH_TOKEN=replace-me-brave-search-token
