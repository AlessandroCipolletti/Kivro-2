# Illustrative examples: do not use placeholders as real credentials.
# For local development, run `pnpm local:auth:up`. It creates a private .env.local
# with passwords, secrets, and storage settings aligned with Docker Compose.

# Node/Next mode: use development locally and production when deployed.
NODE_ENV=development

# Local Compose PostgreSQL password; generated by pnpm local:auth:setup.
KIVRO_LOCAL_DB_PASSWORD=replace-me-db-password

# PostgreSQL connection; use the generated password locally or the database provider's URL in production.
DATABASE_URL=postgresql://kivro:replace-me-db-password@127.0.0.1:15432/kivro

# Redis is optional and is not started by the current Compose setup; use the provider URL when needed.
REDIS_URL=redis://127.0.0.1:6379

# S3-compatible endpoint; SeaweedFS provides it locally, and the selected storage provider provides it when deployed.
# Buyer uploads use signed URLs from the browser; allow APP_ORIGIN in the private bucket's CORS policy.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:18333

# S3 region required by the adapter; use us-east-1 locally or the provider's region in the cloud.
OBJECT_STORAGE_REGION=us-east-1

# Private asset bucket; created locally by pnpm local:auth:up.
OBJECT_STORAGE_BUCKET=kivro-local-private

# S3 access key ID; configured locally by pnpm local:storage:prepare.
OBJECT_STORAGE_ACCESS_KEY_ID=kivrolocal

# S3 secret key; generated in .env.local by pnpm local:storage:prepare or supplied by the storage provider.
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me-generated-storage-secret

# Stripe test-mode API key; find it under API keys in your Stripe account (M08).
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe.js publishable key for the buyer credit-purchase form;
# find it in Stripe Dashboard → Developers → API keys. Use pk_test_ with KIVRO_STRIPE_MODE=test.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Select the Stripe mode matching the key and objects: test locally; use live only with sk_live_ in production.
KIVRO_STRIPE_MODE=test

# Stripe webhook signing secret; find it on the configured webhook endpoint (M08).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Financial cron token; generate at least 32 random characters and send it as Bearer to the reconciliation job.
FINANCE_CRON_SECRET=replace-me-long-random-cron-token
# M11 Marketplace Agent: configure at least one platform-owned provider key.
# OpenAI API dashboard → API keys; this key stays on the Web/API host, never on Worker.
OPENAI_API_KEY=replace-me-openai-platform-key
# Anthropic Console → API keys; optional when OpenAI is configured.
ANTHROPIC_API_KEY=replace-me-anthropic-platform-key
# Select the default provider (openai or anthropic) and a model available in that account.
PLATFORM_AI_DEFAULT_PROVIDER=openai
# Model ID for the configured OpenAI account; find it in the OpenAI model catalog.
OPENAI_PLATFORM_MODEL=replace-me-configured-openai-model
# Model ID for the configured Anthropic account; find it in the Anthropic model catalog.
ANTHROPIC_PLATFORM_MODEL=replace-me-configured-anthropic-model
# Optional JSON task profiles for per-task routing and fallback. If set, this replaces the defaults above.
# Example: {"INTENT_EXTRACTION":{"provider":"openai","model":"your-model","supportsStructuredOutput":true,"supportsTools":true,"inputMicrousdPerMillion":null,"outputMicrousdPerMillion":null}, ...all six tasks...}
# PLATFORM_AI_PROFILES_JSON=
# Local development only: log redacted provider/task/token metadata; production rejects this flag.
PLATFORM_AI_DEBUG_METADATA=false
# Bearer token for POST /api/internal/agent/reconcile; generate 32+ random characters.
AGENT_CRON_SECRET=replace-me-long-random-agent-reconcile-token
# Local Agent reconciler interval in milliseconds; pnpm agent:scheduler calls the authenticated Web/API endpoint.
KIVRO_AGENT_RECONCILE_INTERVAL_MS=5000
# How often `pnpm scheduler` rechecks persisted jobs (milliseconds); run one scheduler process in local development.
KIVRO_SCHEDULER_INTERVAL_MS=5000

# Google Web OAuth client ID; create it in Google Cloud with
# http://localhost:3000/api/auth/callback/google as the local redirect URI.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

# Secret for the same Google Web OAuth client; find it alongside the client ID in Google Cloud.
GOOGLE_CLIENT_SECRET=replace-me-google-client-secret

# Session secret reserved for future configuration; generate a private random value.
SESSION_SECRET=replace-me-random-session-secret

# Public Web/API origin; use the local Next.js URL or the production HTTPS domain.
APP_ORIGIN=http://localhost:3000

# Better Auth session signing secret; generated by pnpm local:auth:setup
# or with `openssl rand -base64 48` for a deployment.
BETTER_AUTH_SECRET=replace-me-generated-auth-secret

# Base64-encoded 32-byte key for auth outbox tokens and links;
# generated by pnpm local:auth:setup or with `openssl rand -base64 32`.
AUTH_OUTBOX_KEY_BASE64=replace-me-base64-32-byte-key

# SMTP host: Mailpit locally, or the email provider's host when deployed.
SMTP_HOST=127.0.0.1

# SMTP port: Mailpit exposes 11025 locally; use the email provider's port when deployed.
SMTP_PORT=11025

# Sender for verification/reset emails; use an address authorized by the SMTP provider.
SMTP_FROM="Kivro Dev <no-reply@kivro.local>"

# SMTP security: LOCAL_PLAINTEXT only on loopback; use STARTTLS or TLS when deployed.
SMTP_SECURITY=LOCAL_PLAINTEXT

# SMTP provider username; local Mailpit does not require authentication.
SMTP_USERNAME=example-smtp-user

# SMTP password/token for the username; local Mailpit does not require it.
SMTP_PASSWORD=replace-me-smtp-password

# Stable Worker discovery URL; supplied by the Kivro deployment (not active in this example).
WORKER_DISCOVERY_URL=https://discovery.example.invalid

# Local loopback development only: permit HTTP discovery and polling to 127.0.0.1.
KIVRO_ALLOW_LOCAL_HTTP=false

# Worker release reported to the control plane; must match the installed release.
KIVRO_WORKER_RELEASE=0.0.0-dev

# For encrypted identity as an alternative to the OS keychain only: private (0600) passphrase file.
# Create the file during pairing; do not put the passphrase in this .env file.
# KIVRO_WORKER_PASSPHRASE_FILE=/Users/example/.kivro/worker/passphrase

# Stable control-plane ID receiving signed Worker messages (not a hostname).
# Use the same ID in discovery and job leases for this deployment.
KIVRO_CONTROL_PLANE_ID=local-primary

# ACTIVE accepts new jobs; DRAINING continues only previously assigned jobs.
KIVRO_CONTROL_PLANE_STATE=ACTIVE

# Brave Search provider credential for the cloud broker; create it in the Brave Search API dashboard.
# M06 never sends it to Worker, OpenClaw, or browsers; live search stays disabled without it.
KIVRO_BRAVE_SEARCH_TOKEN=replace-me-brave-search-token

# Maximum per-job pause duration in seconds; set the operating policy before starting the Worker.
# Example: 14400 = 4 hours. After the limit, the job needs timeout/refund reconciliation.
KIVRO_MAX_PAUSE_DURATION_SECONDS=14400

# Minimum secure Worker version for production (a release published through Kivro's channel).
# Missing configuration blocks new jobs in production; update it with the release policy.
KIVRO_MIN_WORKER_RELEASE=1.0.0

# Latest supported release used to recommend an update.
KIVRO_LATEST_WORKER_RELEASE=1.0.1

# OpenClaw image with the exact digest approved by local conformance tests.
# Find the digest with `docker image inspect` after `pnpm openclaw:approve-local-image`.
KIVRO_OPENCLAW_APPROVED_IMAGE=kivro-openclaw-runtime@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Absolute path to the private record written by `pnpm openclaw:approve-local-image`.
KIVRO_OPENCLAW_APPROVAL_RECORD=/Users/example/.kivro/worker/openclaw-image-approval.json

# Absolute path to the Kivro image source directory compared with the approved record.
KIVRO_OPENCLAW_RUNTIME_ROOT=/path/to/Kivro-2/runtime/openclaw

# Version of the key signing job leases; keep it stable while jobs are running.
# During rotation, retain the previous version until its jobs and leases close.
KIVRO_LEASE_KEY_VERSION=v1

# Base64-encoded 32-byte secret used to reconstruct leases after a cloud restart.
# Generate it with `openssl rand -base64 32`; share the same value across instances of one control plane.
KIVRO_LEASE_KEY_BASE64=replace-me-base64-32-byte-lease-key

# Optional JSON map of old keys during rotation (for example, {"v1":"<base64>"}).
# Use the deployment secret manager; never commit real keys, and remove them only after their leases close.
KIVRO_LEASE_PREVIOUS_KEYS_JSON={}

# Cloud AES-256-GCM key encrypting buyer webhook HMAC secrets in the database.
# Generate it with `openssl rand -hex 32`; store it in the secret manager and plan re-encryption before rotation.
KIVRO_WEBHOOK_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Secret Bearer token for cloud cron `POST /api/internal/webhooks/dispatch`.
# Generate it with `openssl rand -base64 48`; use the same value in the deployment cron job.
KIVRO_WEBHOOK_CRON_SECRET=replace-me-random-webhook-cron-secret-at-least-32-characters

# Control-plane/discovery hosts excluded as webhook destinations; include old hosts during a cutover.
# Derive them from APP_ORIGIN, WORKER_DISCOVERY_URL, and the deployment's public endpoints.
KIVRO_WEBHOOK_BLOCKED_HOSTS=api.example.com,discovery.example.com

# Interval in milliseconds for the local `pnpm webhook:dispatch` dispatcher.
# 5000 = every 5 seconds; supervise the process or cron when deployed.
KIVRO_WEBHOOK_DISPATCH_INTERVAL_MS=5000
