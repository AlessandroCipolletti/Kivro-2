      { "key": "scene", "label": "Blender scene", "order": 1, "required": true, "type": "FILE",
        "constraints": { "maxFiles": 1, "maxFileSizeBytes": 524288000, "maxTotalSizeBytes": 524288000,
          "allowedMimeTypes": ["application/x-blender"], "allowedExtensions": [".blend"] } },
      { "key": "referenceImages", "label": "Reference images", "order": 2, "required": false, "type": "FILES",
        "constraints": { "maxFiles": 10, "maxFileSizeBytes": 10485760, "maxTotalSizeBytes": 104857600,
