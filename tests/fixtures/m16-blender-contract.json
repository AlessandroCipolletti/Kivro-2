          "allowedMimeTypes": ["image/jpeg", "image/png"],
          "allowedExtensions": [".jpg", ".jpeg", ".png"] } },
      { "key": "modifiedScene", "label": "Modified scene", "order": 1, "required": false, "type": "FILE",
