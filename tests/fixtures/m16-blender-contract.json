          "allowedExtensions": [".jpg", ".jpeg", ".png", ".webp"] } },
      { "key": "resolution", "label": "Resolution", "order": 3, "required": true, "type": "SELECT",
        "constraints": { "allowedValues": ["1080p", "1440p", "4K"] }, "defaultValue": "1080p" }
    ]
